# 仓库内统一以 LF 存储，避免 Windows 克隆后 .sh 变成 CRLF
# 导致 Linux 上 `#!/usr/bin/env bash` 报 bad interpreter
* text=auto eol=lf

# 打包产物是二进制，不做行尾转换
*.skill binary
*.png binary
*.jpg binary
*.zip binary

# 明确声明为文本的文件
*.md text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.example text eol=lf
