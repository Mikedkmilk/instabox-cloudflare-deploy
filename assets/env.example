# 部署凭据与目标信息模板
#
# 复制成 .env 后按需填写。⚠️ 本文件永不入库（确认 .gitignore 覆盖 .env）。
# ⚠️ 任何 key / token 都不要在聊天或日志里明文回显。

# ---------------------------------------------------------------- InstaBox
# 获取：instabox.sh → 账户 → API Keys
INSTABOX_API_KEY=<YOUR_INSTABOX_API_KEY>

# 机器名（CLI 用）和机器 ID（保活 API 用，必须是 m_ 开头的 24 位十六进制）
INSTABOX_MACHINE_NAME=web-app
INSTABOX_MACHINE_ID=<MACHINE_ID>

# ---------------------------------------------------------------- Cloudflare
# 方案 A：API Token（无交互，推荐）
#   面板 → 账户 → API Tokens → Create Token
#   权限：Account: Workers Scripts: Edit / Workers KV Storage: Edit / Account Settings: Read
#         Zone: Workers Routes: Edit / Zone: Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 方案 B：交互登录（不填上面两项时使用）
#   npx wrangler login --device      ← 用 --device，普通 login 只有 120 秒窗口
#   npx wrangler login --browser=false

# ---------------------------------------------------------------- 目标域名
# 主域名的 NS 必须已指向 Cloudflare
BASE_DOMAIN=example.com
# 要绑的二级域名（拼成 <TARGET_DOMAIN>）
TARGET_DOMAIN=app.example.com

# ---------------------------------------------------------------- 应用
APP_NAME=web-app
PORT=3000
# 对外地址，务必与实际域名一致，否则 sitemap/robots 里会是错的
SITE_URL=https://app.example.com

# 应用在机器上的目录
APP_DIR=/data/home/web-app
# 大目录（图片/数据）建议与 APP_DIR 分开，便于容量管理
DATA_DIR=/data/home/web-app-data

# ---------------------------------------------------------------- 应用环境变量
# 这些会写进机器上的 .env（权限 600）
AMAP_WEB_KEY=
# 企微群机器人 webhook；留空 = 报名只入库不发通知
WECOM_WEBHOOK_URL=

# ---------------------------------------------------------------- 保活 Worker
WORKER_NAME=instabox-keepalive
# 每 3 分钟一次；间隔必须小于 TTL
KEEPALIVE_CRON=*/3 * * * *
# 租约秒数（30–3600）
KEEPALIVE_TTL=900
# 每轮跑的健康检查命令；留空 = 用内置默认（体检隧道连接器 cloudflared）
# 这关系到能否拿到免费档的 max-run 动态延长，别留空太久
KEEPALIVE_EXEC_CMD=
# Worker 访问口令，不设则任何人知道域名就能触发续租
# 生成：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
WORKER_TOKEN=
